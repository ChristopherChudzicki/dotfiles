#!/bin/sh
# Detect whether a kubeconfig grants read/write access to ODL EKS.
#
# eks.py names each user entry "<cluster>-<mode>"; a read-only login yields only
# "*-readonly" users, while developer/admin logins add write-capable
# "*-developer" / "*-admin" users. Presence of the latter means the file can
# mutate clusters (including production).
#
# Prints a short label and exits 0 when write-capable; silent + exits 1
# otherwise (read-only, or file absent). Single source of truth for the shell
# prompt (starship) and Claude Code's statusline.
#
# Optional arg: kubeconfig path (default ~/.kube/ol-eks.yaml).

kubeconfig="${1:-$HOME/.kube/ol-eks.yaml}"

[ -f "$kubeconfig" ] || exit 1

if grep -Eq -- '-(developer|admin)$' "$kubeconfig" 2>/dev/null; then
    printf '%s' '⚠ ol-eks:RW'
    exit 0
fi

exit 1
